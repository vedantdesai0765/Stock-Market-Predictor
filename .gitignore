
# Ignore Python cache
__pycache__/
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/

# Ignore environment and secret files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
client_secret*.json
token.json

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Build and test artifacts
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Keep processed datasets and model dirs tracked (app.py reads them at startup)
data/processed/*.png
models/**/*.pkl
models/**/*.keras
models/**/*.h5

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/
# Sentiment study: large or licence-restricted data (recreate with sentiment_study/src/download_data.py)
sentiment_study/data/interim/
sentiment_study/data/raw/*
!sentiment_study/data/raw/sentfin/
sentiment_study/data/raw/finbert_entity/
sentiment_study/data/processed/nyt_finance_headlines_scored.parquet
sentiment_study/data/processed/fnspid_ndx_titles_scored.parquet
sentiment_study/reports/oof/
sentiment_study/reports/oof_company/
*.safetensors
sentiment_study/reports/logs/
