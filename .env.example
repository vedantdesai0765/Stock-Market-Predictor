# =====================================================================
# Stock Market Predictor — Environment Configuration Template
# =====================================================================
# Copy this file to .env and configure for your deployment environment.
# .env is ignored by git and must NEVER contain hardcoded production secrets.

# Backend Configuration
ENVIRONMENT=production
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Defaults to local SQLite if unset)
# For production PostgreSQL: postgresql://user:password@localhost:5432/stock_market_db
DATABASE_URL=sqlite:///data/app.db

# Financial News API (Optional developer key from https://newsapi.org)
NEWSAPI_KEY=your_newsapi_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Morning Call (optional): public address of this repository's live/ folder, so the API serves the
# newest daily forecast without being redeployed. Leave empty to read the local live/ folder.
MORNING_DATA_URL=
